#!/bin/bash
#SBATCH -N <NODES>
#SBATCH -n <TASKS>
#SBATCH -c 2
#SBATCH -t <TIME>
#SBATCH --output=output/slurm/hpl_config_<CONFIG_ID>_job_%j.out
#SBATCH --error=output/slurm/hpl_config_<CONFIG_ID>_job_%j.err
#SBATCH --chdir=<ROOT>
#SBATCH --exclusive

source .bashrc

add_build $INSTALL_DIR/OpenBLAS OpenBLAS
add_build $INSTALL_DIR/OpenMPI OpenMPI

HPL="<HPL_LOCATION>"
ROOT="<ROOT>"
OUTPUT=$ROOT/output

FILENAME="HPL_RUN"
CONFIG_ID="<CONFIG_ID>"
CONFIG_PATH="<CONFIG_PATH>"
RUN_ID="config_${CONFIG_ID}_job_${SLURM_JOB_ID}"
DESCRIPTION="$FILENAME, $RUN_ID, <DESCRIPTION>"

echo "$SLURM_JOB_ID : $DESCRIPTION" >> $OUTPUT/descriptions.txt

OUTDIR=$OUTPUT/$FILENAME
mkdir -p $OUTDIR

# HPL uses one MPI rank per physical core; do not oversubscribe ranks.
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1

export OMP_PROC_BIND=close
export GOMP_CPU_AFFINITY="0-11"

export OMPI_MCA_mca_verbose=0

export OMPI_MCA_btl_tcp_if_include=enp1s0 
export OMPI_MCA_btl=tcp,self

echo "------ SLURM ASSIGNMENT ------"
# scontrol show hostnames $SLURM_NODELIST | \
#     awk '{print $1 " slots=6"}' > /tmp/hpl_hosts_$SLURM_JOB_ID
echo $SLURM_NODELIST
echo $SLURM_NTASKS
echo $SLURM_NNODES

mkdir -p "$OUTPUT/dats" "$OUTDIR"
cp -f "$CONFIG_PATH" "$OUTPUT/dats/HPL_${RUN_ID}.dat"

# HPL requires HPL.dat in its working directory.  Stage it privately per
# rank, so simultaneous jobs never overwrite a shared input file.
export HPL_EXECUTABLE="$HPL"
export HPL_CONFIG_PATH="$CONFIG_PATH"
export HPL_RUN_BASE="/tmp/hpl_${USER}_${RUN_ID}"

srun --mpi=pmix --hint=nomultithread --cpu-bind=cores \
    bash -c 'HPL_RUN_DIR="${HPL_RUN_BASE}_${SLURM_PROCID}"; mkdir -p "$HPL_RUN_DIR" && cp -f "$HPL_CONFIG_PATH" "$HPL_RUN_DIR/HPL.dat" && cd "$HPL_RUN_DIR" && exec "$HPL_EXECUTABLE"' \
    | tee "$OUTDIR/hpl_${RUN_ID}.out"




