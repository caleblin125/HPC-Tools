#!/bin/bash
#SBATCH -N <NODES>
#SBATCH -n <TASKS>
#SBATCH -c 1
#SBATCH --ntasks-per-node=6
#SBATCH -t <TIME>
#SBATCH --output=output/slurm/hpl_ai_config_<CONFIG_ID>_job_%j.out
#SBATCH --error=output/slurm/hpl_ai_config_<CONFIG_ID>_job_%j.err
#SBATCH --chdir=<ROOT>
#SBATCH --exclusive

set -euo pipefail
source /haydean/caleb/spack/spack/share/spack/setup-env.sh
eval "$(spack load --sh intel-oneapi-mpi intel-oneapi-mkl)"

HPL="<HPL_LOCATION>"
ROOT="<ROOT>"
CONFIG_ID="<CONFIG_ID>"
CONFIG_PATH="<CONFIG_PATH>"
RUN_ID="config_${CONFIG_ID}_job_${SLURM_JOB_ID}"
OUTPUT="$ROOT/output"
OUTDIR="$OUTPUT/HPL_AI_RUN"

mkdir -p "$OUTDIR" "$OUTPUT/dats"
cp -f "$CONFIG_PATH" "$OUTPUT/dats/HPL_AI_${RUN_ID}.dat"

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export I_MPI_HYDRA_BOOTSTRAP=slurm
export I_MPI_PIN_DOMAIN=core
export I_MPI_PIN_ORDER=compact
export HPL_EXECUTABLE="$HPL"
export HPL_CONFIG_PATH="$CONFIG_PATH"
export HPL_RUN_BASE="/tmp/hpl_ai_${USER}_${RUN_ID}"

echo "$SLURM_JOB_ID : HPL_AI_RUN, $RUN_ID, <DESCRIPTION>" >> "$OUTPUT/descriptions.txt"
echo "------ SLURM ASSIGNMENT ------"
echo "$SLURM_NODELIST"
echo "$SLURM_NTASKS"
echo "$SLURM_NNODES"

mpirun -bootstrap slurm -ppn 6 -np "$SLURM_NTASKS" \
    bash -c 'HPL_RUN_DIR="${HPL_RUN_BASE}_${PMI_RANK:-${MPI_LOCALRANKID:-$$}}"; mkdir -p "$HPL_RUN_DIR"; cp -f "$HPL_CONFIG_PATH" "$HPL_RUN_DIR/HPL.dat"; cd "$HPL_RUN_DIR"; exec "$HPL_EXECUTABLE"' \
    | tee "$OUTDIR/hpl_config_${CONFIG_ID}_job_${SLURM_JOB_ID}.out"
